DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
APP_VERSION="1.0.0"

# Required for merchant-facing payment links and QR codes.
# Set this to the real public origin users open in their browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional but recommended for WalletConnect-compatible wallets.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=""
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
ADMIN_PANEL_PATH="/secure-admin"
ADMIN_WALLETS=""
ARCPAY_DEBUG_REQUESTS="0"
PRISMA_QUERY_LOGGING="false"
JOB_WORKER_POLL_INTERVAL_MS="5000"
JOB_WORKER_SCAN_INTERVAL_MS="30000"
JOB_WORKER_STALE_SECONDS="120"
JOB_WORKER_CLAIM_LIMIT="10"
NEXT_PUBLIC_ARC_CHAIN_ID="5042002"
NEXT_PUBLIC_ARC_RPC_URL="https://rpc.testnet.arc.network"
NEXT_PUBLIC_ARC_EXPLORER_URL="https://testnet.arcscan.app"
NEXT_PUBLIC_ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"
NEXT_PUBLIC_ARC_USDC_DECIMALS="6"
ENABLE_SIMULATED_PAYMENTS="false"

# Optional AI Copilot integration.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
AI_COPILOT_ENABLED="false"
